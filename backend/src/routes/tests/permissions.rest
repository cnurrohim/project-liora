POST http://localhost:4000/auth/login
Content-Type: application/json

{
  "username": "alice",
  "password": "password"
}

###

# Ganti token di bawah ini dengan hasil dari login
@token = Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


### Get all permissions
GET http://localhost:4000/permissions
Authorization: Bearer {{token}}

### Create new permission
POST http://localhost:4000/permissions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "edit_profile",
  "description": "Allows editing own profile"
}

@permissionId = 1

### Update permission
PUT http://localhost:4000/permissions/{{permissionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "edit_profile",
  "description": "Allows editing user profile"
}

### Delete permission
DELETE http://localhost:4000/permissions/{{permissionId}}
Authorization: Bearer {{token}}
